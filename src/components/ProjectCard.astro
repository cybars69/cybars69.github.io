---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const href = `/projects/${project.id}/`;
const killed = p.status === 'killed';
const linkClass = 'col-3 mx-auto d-flex align-items-center justify-content-center my-2';
---

<div class:list={['col-10 col-lg-5 px-2 pb-3 pt-5 mx-auto my-3 frost glow-border border-even project-card', { killed }]}>
  <a href={href} class="project-media col-11 mx-auto d-block p-0" aria-label={p.title}>
    <img src={p.image} alt={p.alt ?? p.title} loading="lazy" />
    {killed && <span class="killed-stamp">Killed</span>}
  </a>
  <div class="col-10 mx-auto my-3">
    <a href={href} class="h5 project-title d-block">{p.title}</a>
    {p.kind && <div class="project-kind mb-2">{p.kind}</div>}
    <div>{p.blurb}</div>
    {p.tags.length > 0 && <div class="mt-3">{p.tags.map((t) => <span class="tag-chip">{t}</span>)}</div>}
    <a href={href} class="stack-more d-inline-block mt-3">Read more →</a>
  </div>
  <div class="row col-9 mx-auto">
    {p.github && (
      <a class={linkClass} href={p.github} target="blank" rel="noreferrer" aria-label={`${p.title} on GitHub`}>
        <i class="fab fa-github fa-3x"></i>
      </a>
    )}
    {p.live && !killed && (
      <a class={linkClass} href={p.live} target="blank" rel="noreferrer" aria-label={`${p.title} live site`}>
        <img src="/images/logos/live.svg" alt={`Live site ${p.title}`} style="height: 3em" />
      </a>
    )}
  </div>
</div>
